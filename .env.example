# Copy to .env and edit. Never commit .env.

# Required. The one password you both use to open the app. Use a long passphrase.
TS_PASSWORD=change-me-to-a-long-passphrase

# Optional: who push services can contact if something is wrong (mailto: or https URL).
# VAPID_SUBJECT=mailto:you@example.com

# Optional (defaults shown). Inside Docker leave these alone.
# PORT=47318
# HOST=0.0.0.0
# DATA_DIR=./data
